@@RESULTS {"test_r316": [["#316 SW 版本 v278+（第 327 次升 v289）", true, ""], ["#316 弹簧参数：点击滑行 tap 临界阻尼 k≈600、点击速度形变 ×0.45、收回 k≥1500（~4 帧）、松手吸附 k 560、提前收回阈值", true, "{'grow': {'k': 520, 'z': 0.58}, 'drag': {'k': 6000, 'z': 1}, 'snap': {'k': 560, 'z': 0.74}, 'shape': {'k': 420, 'z': 0.38}, 'shrink': {'k': 1700, 'z': 1}, 'tap': {'k': 600, 'z': 1}, 'tapV': 0.45, 'exitPx': 2.5, 'exitV': 150, 'exitMs': 90, 'vFull': 0.9, 'stretch': 0.12, 'squash': 0.11, 'rubber': 26, 'rubberC': 0.55, 'fuse': 8, 'lead': {'k': 1200, 'z': 1}, 'trail': {'k': 560, 'z': 1}, 'trailHold': 40, 'tapGrow': {'k': 1600, 'z': 1}, 'tapMaxW': 104, 'tapDH': -4, 'tapBulge': 8, 'bigAfter': 160, 'press': {'k': 1500, 'z': 0.8, 'amp': 0.038}, 'release': {'k': 250, 'z': 0.6}, 'catchUp': 1.5, 'bigV': 2400, 'bigMax': 0.15, 'bigSq': 0.08, 'bigShape': {'k': 1500, 'z': 1}, 'retargetTau': 80, 'jelly': {'k': 250, 'z': 0.7}, 'hitGain': 3.6, 'hitZone': 3, 'hitV': 120, 'endInset': 4, 'jellySy': 0.8, 'jellyMax': 0.18, 'jellyDH': 4, 'endPullK': 0.6, 'endPullMax': 7, 'kEnd': 10}"], ["#316 静止选中胶囊：高 = 栏高 − 8（上下各 ~4；栏高不计第 327 次 GL 边框盒多出的 2px）、宽 = 页签宽 + 12、与页签同中心（原生胶囊几乎贴栏高，第 315 次 64×44 缩在里面）", true, "{'w': 76, 'h': 52, 'aw': 64, 'H': 60, 'top': 5, 'bot': 5, 'cx': 161, 'acx': 161, 'T': {'INSET': 4, 'PX': 12}}"], ["#316 GL 画布在画时 CSS 高光描边 / 内光（::before / ::after）藏掉——dock 只剩着色器那一道细光边（原来外一圈 + 往里 4px 一圈双线）", true, "{'on': True, 'bf': '0', 'af': '0'}"], ["#316 单轮廓规则只在 GL 画布 on 时生效（滚动中画布暂停 / 关掉 GL 时 CSS 描边照旧）", true, ""], ["#316 透镜高光 / 按下亮弧 / 投影随鼓起比例渐显（gr = smoothstep(.05,.5,uLG)），按下第 1 帧不「啪」地带满亮边", true, ""], ["#316 点击总时长：按下到透镜收回胶囊 14~19 帧（支付宝 22:03 约 17 帧、App Store 约 14 帧；第 315 次 23 帧）", true, "19"], ["#316 点击滑行先冲后缓：+4 帧 45%~75%、+8 帧 ≥75%、+12 帧 ≥88%，全程单调不越过目标（支付宝 +4≈45% / +12≈87%，App Store +3≈46% / +6≈82%）", true, "[0.0, 0.071, 0.179, 0.335, 0.491, 0.617, 0.715, 0.789, 0.845, 0.886, 0.917, 0.939, 0.956, 0.968, 0.976, 0.983, 0.988, 0.991, 0.994]"], ["#316 收回胶囊 ≤5 帧（支付宝 3 帧、App Store 4~5 帧；第 315 次 6 帧）", true, "5"], ["#316 点击滑行速度形变减半：透镜纵向压扁
@@RESULTS {"test_r328": [["#328 源码：lens-phys.js 在 dock-refract / liquid-dock 之前加载、SW 预缓存 lens-phys.js 与 dock-worker.js；CSP worker-src self；liquid-dock.js 不再自带 PHYS / springStep", true, ""], ["#328 Worker 路径启用：stats.worker = on、Worker 里 webgl 建成（ready.ok）、画布已转交（主线程 getContext 抛错）、backing = CSS × 3（第 327 次）", true, "['on', {'wm': True, 'wOK': 1, 'info': {'t': 'ready', 'ok': True, 'raf': True, 'ver': 'WebGL 1.0 (OpenGL ES 2.0 Chromium)', 'err': ''}, 'fail': '', 'q': {'batches': 6, 'cmds': 227, 'bitmaps': 3, 'bmMs': 2.4}, 'url': 'http://127.0.0.1:38965/js/dock-worker.js'}, [348, 126, True], [1044, 378]]"], ["#328 参数不变：LiquidDock.PHYS 与 890721d 逐项相同、就是 LensPhys.PHYS；Worker 与主线程的 PHYS / step / geom / pace / dsCurve 源码一致（同一个文件）", true, "[True, '{\"grow\":{\"k\":520,\"z\":0.58},\"drag\":{\"k\":6000,\"z\":1},\"snap\":{\"k\":560,\"z\":0.74},\"sh']"], ["#328 17 帧点击节奏（60Hz 手动时钟）：+4 / +8 / +12 帧 ≈ 48 / 83 / 95%（±5），约 17~19 帧收完；手动时钟下不走 Worker 物理（lens 无 w 标记）", true, "[[49.1, 84.5, 95.6], 19]"], ["#328 lgWorker = 0：走主线程实现（worker off）", true, "off"], ["#328 静止时 Worker 画的 dock 与主线程实现逐像素一致（最大差 ≤ 2 级）", true, "0"], ["#328 切页时主线程同步忙 200ms：Worker 透镜在忙碌窗口里照样出帧（≥ 2 帧；软件 GL 下每帧 30~70ms）、最大帧间隔 < 160ms（主线程实现 ≥ 200ms）、落到目标页签（终点 = 弹簧目标 tx，差 < 1.5px）、页面切过去", true, "[5, 91, {'t': 9959, 'raw': 52.2, 'dt': 73.6, 'work': 0.3, 'k': 'end', 'x': 96.76353518177409, 'tx': 96.75937217246316, 'jcMax': 0.028547551812201838, 'rt': 0}, 96.75937217246316, 'baby', 'baby']"], ["#328 连点改目标（第 321 次）在 Worker 里：retarget ≥ 1、透镜终点落在第二次点的页签、页面也是它", true, "[{'t': 12877, 'raw': 66.8, 'dt': 78.5, 'work': 0.1, 'k': 'end', 'x': 98.63640041012873, 'tx': 98.35339443162744, 'jcMax': 0.12228752317002813, 'rt': 1}, 96]"], ["#328 撞端果冻（第 322 次）在 Worker 里同样发生（jc 峰值 > 0.03；60Hz 下 ≈0.15，软件 GL 帧粗时撞墙那一帧的前缘速度被摊平，峰值偏低）", true, "0.037051814301986515"], ["#328 Worker 模式下整条 dock 按下放大 = 合成器 scale 动画（按住时在跑），松手停稳后不留动画 / 内联 scale", true, "[9, [0, '']]"], ["#328 Worker 模式：顶部提示岛不画 GL（主线程读不到转交的画布），DR.surface(toast) 返回 false", true, ""], ["#328 对照：主线程实现在同一个 200ms 忙碌窗口里透镜 0 帧（这就是 Worker 要解决的停顿）", true, "[0, 5]"], ["#328 退化：Worker 里拿不到 webgl → 本次会话退回主线程实现（worker = fail、原因 no-webgl-in-worker、主线程 GL 在画），透镜走主线程 lensFrame、切页成功", true, "['fail', 'no-webgl-in-worker', 2, 5]"], ["#328 退化：没有 OffscreenCanvas → 不起 Worker，主线程实现照常画", true, "['off', 2]"], ["#328 无页面错误", true, "[]"]]}
